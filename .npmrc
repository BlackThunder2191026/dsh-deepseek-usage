# dsh resolves this package's peers from its own profile tree
# (<DSH_HOME>/profiles/node_modules), so the installer must not try to fetch the
# whole peer graph: some @deepseek-ai/* peers are not published, and pnpm's
# default auto-install-peers would fail the install with a 404.
auto-install-peers=false

# This package has no dependencies; keep the install offline-friendly anyway.
prefer-offline=true
