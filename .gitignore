# Packed artifacts are produced locally with `npm run pack`; they are not
# committed, because a Git install builds from source and an npm install
# publishes them instead.
dist/

# The hand-off folder assembled from dist/ for one-off delivery (the tarball plus
# its own install notes). Reproducible with `npm run release`, so it is not tracked.
release/

# Installer output
node_modules/
pnpm-lock.yaml
package-lock.json
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.swp
